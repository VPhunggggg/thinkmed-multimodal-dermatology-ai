# ThinkMed Environment Configuration Template
# Copy this file to .env and fill in your API keys

# Groq API Key (Get free key at: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# LLM Backend: groq | ollama | anthropic | none
LLM_BACKEND=groq

# Optional Anthropic Claude API Key
ANTHROPIC_API_KEY=

# Optional Local Ollama URL
OLLAMA_URL=http://localhost:11434
